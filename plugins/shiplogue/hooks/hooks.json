{
  "description": "Capture Claude Code activity locally for Shiplogue stand-ups.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "shiplogue hook claude --event SessionStart", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "shiplogue hook claude --event UserPromptSubmit", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "shiplogue hook claude --event PreToolUse", "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "shiplogue hook claude --event PostToolUse", "timeout": 10 }] }
    ],
    "PostToolUseFailure": [
      { "hooks": [{ "type": "command", "command": "shiplogue hook claude --event PostToolUseFailure", "timeout": 10 }] }
    ],
    "PostToolBatch": [
      { "hooks": [{ "type": "command", "command": "shiplogue hook claude --event PostToolBatch", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "shiplogue hook claude --event Stop", "timeout": 10 }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "shiplogue hook claude --event StopFailure", "timeout": 10 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "shiplogue hook claude --event SubagentStop", "timeout": 10 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "shiplogue hook claude --event SessionEnd", "timeout": 10 }] }
    ]
  }
}
